---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, description, align = 'left' } = Astro.props;
---

<div class:list={['max-w-3xl', align === 'center' && 'mx-auto text-center']}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 class:list={['section-title', eyebrow && 'mt-4', align === 'center' && 'mx-auto']}>
    {title}
  </h2>
  {description && (
    <p class:list={['body-large mt-6', align === 'center' && 'mx-auto']}>
      {description}
    </p>
  )}
</div>
