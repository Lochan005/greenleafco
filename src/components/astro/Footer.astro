---
import { secondaryNav, siteName } from '@/lib/seo/site';

const year = new Date().getFullYear();
---

<footer class="bg-botanical-deep text-canvas">
  <div class="site-container py-14 md:py-20">
    <div class="grid gap-12 border-b border-canvas/20 pb-14 md:grid-cols-[1.5fr_1fr]">
      <div>
        <p class="eyebrow !text-sage">Wholesale produce</p>
        <p class="mt-5 max-w-xl font-display text-[clamp(2.2rem,5vw,4.8rem)] leading-[0.98]">
          Start a better produce conversation.
        </p>
        <a class="button mt-8 border border-canvas bg-canvas text-botanical-deep hover:bg-transparent hover:text-canvas" href="/request-a-quote">
          Request a Quote
        </a>
      </div>
      <nav aria-label="Footer" class="md:justify-self-end">
        <p class="mb-4 text-xs font-bold tracking-[0.12em] text-sage uppercase">Explore</p>
        <ul class="grid gap-3">
          <li><a class="no-underline hover:text-sage" href="/products">Products</a></li>
          {secondaryNav.map((item) => (
            <li><a class="no-underline hover:text-sage" href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
    <div class="flex flex-col gap-3 pt-6 text-xs text-sage md:flex-row md:items-center md:justify-between">
      <p>© {year} {siteName}. All rights reserved.</p>
      <p>Wholesale enquiries only. Content details are subject to confirmation.</p>
    </div>
  </div>
</footer>
