---
import BaseLayout from '@/layouts/BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  heading?: string;
}

const { title, description, heading = title } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <main class="mx-auto max-w-3xl px-6 py-16">
    <p class="text-xs font-medium tracking-[0.14em] text-muted uppercase">Placeholder</p>
    <h1 class="mt-3 font-display text-4xl text-botanical">{heading}</h1>
    <div class="mt-4 max-w-xl text-lg leading-relaxed">
      <slot />
    </div>
  </main>
</BaseLayout>
