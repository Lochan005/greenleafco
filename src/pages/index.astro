---
import JournalCard from '@/components/astro/JournalCard.astro';
import MediaPlaceholder from '@/components/astro/MediaPlaceholder.astro';
import QuoteCTA from '@/components/astro/QuoteCTA.astro';
import SectionHeading from '@/components/astro/SectionHeading.astro';
import {
  splashVideoMp4,
  splashVideoPoster,
  splashVideoWebm,
} from '@/lib/content/splashVideo';
import {
  categoryMenuImages,
  categoryTitleToSlug,
  journalEnabled,
  productCategories,
  publicAssetPath,
  siteName,
} from '@/lib/seo/site';
import { getHomepage, getJournalEntries } from '@/lib/sanity/content';
import { sanityImageUrl } from '@/lib/sanity/image';
import BaseLayout from '@/layouts/BaseLayout.astro';

const [homepage, fallbackJournalEntries] = await Promise.all([
  getHomepage(),
  journalEnabled ? getJournalEntries() : Promise.resolve([]),
]);
const journalEntries = journalEnabled
  ? homepage?.featuredJournalEntries?.length
    ? homepage.featuredJournalEntries
    : fallbackJournalEntries
  : [];
const socialImage = sanityImageUrl(homepage?.seo?.image ?? homepage?.heroImage, 1200, 630);
---

<BaseLayout
  title={homepage?.seo?.title ?? siteName}
  description={homepage?.seo?.description ?? 'Explore premium exotic vegetables, herbs, microgreens, leafy greens, seasonal produce, and specialty ingredients for professional buyers.'}
  image={socialImage}
>
  <main>
    <section class="relative flex min-h-[calc(100svh-5rem)] items-center overflow-hidden bg-botanical-deep py-16 text-canvas md:py-24">
      <video
        class="pointer-events-none absolute inset-0 h-full w-full object-cover"
        autoplay
        loop
        muted
        playsinline
        preload="auto"
        poster={splashVideoPoster}
      >
        {splashVideoWebm && <source src={splashVideoWebm} type="video/webm" />}
        <source src={splashVideoMp4} type="video/mp4" />
      </video>
      <div
        class="pointer-events-none absolute inset-0 bg-gradient-to-r from-charcoal/80 via-charcoal/55 to-charcoal/30"
        aria-hidden="true"
      />
      <div class="site-container relative z-10">
        <div class="max-w-3xl">
          <p class="eyebrow !text-sage">Premium Produce for Kitchen Aficionado</p>
          <h1 class="display-title mt-4 max-w-[18ch] text-[clamp(2.75rem,5vw,5.5rem)] text-canvas">
            Distinctive Produce. Exceptional Possibilities.
          </h1>
          <p class="body-large mt-5 max-w-2xl !text-canvas/90">
            From exotic vegetables and fresh herbs to microgreens and specialty produce, we supply restaurants, hotels, retailers and food businesses across Bengaluru with ingredients that inspire better menus.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a class="button border border-canvas bg-canvas text-botanical-deep hover:bg-transparent hover:text-canvas" href="/products">
              Explore Our Produce
            </a>
            <a class="button border border-canvas/80 bg-transparent text-canvas hover:border-canvas hover:bg-canvas hover:text-botanical-deep" href="/request-a-quote">
              Request a Quote
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="section-space border-y border-line">
      <div class="site-container">
        <SectionHeading
          eyebrow="The range"
          title="Seven ways into a more distinctive menu."
          description="Browse the catalogue by produce family, then enquire about the products and formats that fit your operation."
        />
        <div class="mt-12 grid border-t border-line sm:grid-cols-2 lg:grid-cols-3">
          {
            productCategories.map((category, index) => (
              <a
                href={`/products?category=${encodeURIComponent(categoryTitleToSlug(category))}`}
                class="group relative flex min-h-64 flex-col overflow-hidden border-b border-line no-underline sm:odd:border-r sm:even:pl-0 lg:border-r lg:nth-[3n]:border-r-0"
              >
                <img
                  src={publicAssetPath(categoryMenuImages[category])}
                  alt=""
                  width={800}
                  height={600}
                  loading={index < 3 ? 'eager' : 'lazy'}
                  decoding="async"
                  class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 ease-out motion-reduce:transition-none group-hover:scale-105 motion-reduce:group-hover:scale-100"
                />
                <div
                  class="absolute inset-0 bg-gradient-to-t from-canvas/90 from-25% via-canvas/25 via-55% to-transparent opacity-100 transition-opacity duration-500 ease-out motion-reduce:transition-none group-hover:opacity-0 motion-reduce:group-hover:opacity-100"
                  aria-hidden="true"
                />
                <div class="relative flex min-h-64 flex-1 flex-col justify-between px-5 py-7 sm:even:pl-6 lg:px-6 lg:first:pl-0">
                  <span class="text-xs text-muted transition-[text-shadow] duration-500 group-hover:[text-shadow:0_1px_18px_rgb(246_241_231_/_0.95),0_0_1px_rgb(246_241_231_/_0.9)]">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <div class="text-center">
                    <h3 class="text-3xl leading-tight text-botanical transition-[text-shadow] duration-500 group-hover:[text-shadow:0_2px_24px_rgb(246_241_231_/_0.95),0_0_2px_rgb(246_241_231_/_0.9)]">
                      {category}
                    </h3>
                  </div>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="bg-paper">
      <div class="site-container grid gap-10 py-16 md:grid-cols-[0.9fr_1.1fr] md:items-center md:py-28">
        <img
          src="/professional-kitchen.jpg"
          alt="Exotic vegetables, microgreens, and specialty produce in crates on a professional kitchen counter"
          width="1024"
          height="559"
          loading="lazy"
          decoding="async"
          class="aspect-[3/2] w-full border border-line object-cover"
        />
        <div class="md:pl-[8vw]">
          <p class="eyebrow">Who we serve</p>
          <h2 class="section-title mt-4">Selected for people who work with produce.</h2>
          <p class="body-large mt-6">
            From menu development to retail presentation and distribution, the
            conversation begins with how your business buys, handles, and uses fresh produce.
          </p>
          <ul class="mt-8 grid gap-3 border-t border-line pt-6 sm:grid-cols-2">
            {
              [
                ['01', 'Restaurants & chefs'],
                ['02', 'Hotels & hospitality'],
                ['03', 'Retail teams'],
                ['04', 'Resellers & distributors'],
              ].map(([number, label]) => (
                <li class="flex items-baseline gap-3 border border-line bg-canvas px-4 py-3.5 transition-colors duration-200 hover:border-botanical/40">
                  <span class="text-xs font-bold tracking-[0.12em] text-moss">{number}</span>
                  <span class="font-display text-xl leading-snug text-botanical">{label}</span>
                </li>
              ))
            }
          </ul>
          <a class="text-link mt-8" href="/who-we-serve">See who we work with</a>
        </div>
      </div>
    </section>

    <section class="relative overflow-hidden bg-[#f8f4e8] py-16 md:py-24">
      <img
        src="/delivery/kale-corner.jpg"
        alt=""
        width="215"
        height="120"
        loading="lazy"
        decoding="async"
        aria-hidden="true"
        class="pointer-events-none absolute bottom-0 left-0 z-0 hidden w-48 select-none md:block lg:w-60"
      />
      <div class="site-container relative z-10 grid items-start gap-10 lg:grid-cols-[0.82fr_1.18fr] lg:gap-12">
        <div class="max-w-md pt-2 md:pb-24">
          <p class="text-[0.7rem] font-bold tracking-[0.14em] text-[#5c6454] uppercase">
            Packed thoughtfully. Delivered responsibly.
          </p>
          <h2 class="mt-4 font-display text-[clamp(2.5rem,4.5vw,3.85rem)] leading-[1.02] tracking-[-0.03em] text-charcoal">
            Better choices at every step.
          </h2>
          <p class="mt-6 text-[0.98rem] leading-[1.65] text-[#66615b]">
            From the materials we pack in to the vehicles that bring produce to your
            door, we make conscious choices to reduce our environmental footprint.
          </p>
        </div>

        <div class="grid gap-4 sm:grid-cols-2 sm:gap-5">
          <!-- Card 1: Compostable packaging -->
          <article class="relative flex min-h-48 flex-col justify-between overflow-hidden rounded-2xl border border-[#e3dfd3] bg-[#f2f0e4] p-6">
            <img
              src="/delivery/compostable.jpg"
              alt="Compostable packaging container"
              width="132"
              height="140"
              loading="lazy"
              decoding="async"
              class="pointer-events-none absolute right-0 bottom-0 h-[92%] w-[46%] object-contain object-right-bottom select-none"
            />
            <div
              class="pointer-events-none absolute inset-y-0 right-[36%] w-12 bg-gradient-to-r from-[#f2f0e4] to-transparent"
              aria-hidden="true"
            />
            <div class="relative z-10 max-w-[60%]">
              <span
                class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-[#b5bf9d] text-white"
                aria-hidden="true"
              >
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M17 8C8 10 5.9 16.17 3.82 21.34l1.89.66l.95-2.3c.48.17.98.3 1.34.3C19 20 22 3 22 3c-1 2-8 2.25-13 3.25S2 11.5 2 13.5s1.75 3.75 1.75 3.75C7 8 17 8 17 8Z" />
                </svg>
              </span>
              <h3 class="mt-3.5 font-display text-[1.45rem] leading-[1.15] text-charcoal">
                Compostable<br />packaging
              </h3>
              <p class="mt-2.5 text-[0.82rem] leading-[1.45] text-[#66615b]">
                We use compostable packaging options to reduce reliance on single-use materials.
              </p>
            </div>
          </article>

          <!-- Card 2: Recyclable materials -->
          <article class="relative flex min-h-48 flex-col justify-between overflow-hidden rounded-2xl border border-[#e3dfd3] bg-[#f5efe3] p-6">
            <img
              src="/delivery/recyclable.jpg"
              alt="Recyclable cardboard box with fresh produce"
              width="126"
              height="145"
              loading="lazy"
              decoding="async"
              class="pointer-events-none absolute right-0 bottom-0 h-full w-[45%] object-cover object-right-bottom select-none"
            />
            <div
              class="pointer-events-none absolute inset-y-0 right-[35%] w-12 bg-gradient-to-r from-[#f5efe3] to-transparent"
              aria-hidden="true"
            />
            <div class="relative z-10 max-w-[60%]">
              <span
                class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-[#b5bf9d] text-[#1c2819]"
                aria-hidden="true"
              >
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M7 19H4.815a1.83 1.83 0 0 1-1.57-.881 1.785 1.785 0 0 1-.004-1.784L7.196 9.5" />
                  <path d="M11 19h8.203a1.83 1.83 0 0 0 1.556-.89 1.784 1.784 0 0 0 0-1.775l-1.226-2.12" />
                  <path d="m14 16-3 3 3 3" />
                  <path d="M8.293 13.596 7.196 9.5 3.1 10.598" />
                  <path d="m9.344 5.811 1.093-1.892A1.83 1.83 0 0 1 11.985 3a1.784 1.784 0 0 1 1.546.888l3.943 6.843" />
                  <path d="m13.378 9.633 4.096 1.098 1.097-4.096" />
                </svg>
              </span>
              <h3 class="mt-3.5 font-display text-[1.45rem] leading-[1.15] text-charcoal">
                Recyclable<br />materials
              </h3>
              <p class="mt-2.5 text-[0.82rem] leading-[1.45] text-[#66615b]">
                Our recyclable packaging materials support more responsible handling and disposal.
              </p>
            </div>
          </article>

          <!-- Card 3: Electric vehicle deliveries -->
          <article class="relative flex min-h-48 flex-col justify-between overflow-hidden rounded-2xl border border-[#e3dfd3] bg-[#f3f1e4] p-6">
            <img
              src="/delivery/electric-van.jpg"
              alt="Green Leaf electric delivery van"
              width="122"
              height="146"
              loading="lazy"
              decoding="async"
              class="pointer-events-none absolute right-0 bottom-0 h-[95%] w-[44%] object-contain object-right-bottom select-none"
            />
            <div
              class="pointer-events-none absolute inset-y-0 right-[34%] w-12 bg-gradient-to-r from-[#f3f1e4] to-transparent"
              aria-hidden="true"
            />
            <div class="relative z-10 max-w-[60%]">
              <span
                class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-[#b5bf9d] text-white"
                aria-hidden="true"
              >
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M13 2L4.09 12.63a1 1 0 0 0 .77 1.64H11v7.73l8.91-10.63a1 1 0 0 0-.77-1.64H13V2Z" />
                </svg>
              </span>
              <h3 class="mt-3.5 font-display text-[1.45rem] leading-[1.15] text-charcoal">
                Electric vehicle<br />deliveries
              </h3>
              <p class="mt-2.5 text-[0.82rem] leading-[1.45] text-[#66615b]">
                Every Green Leaf delivery is made using electric vehicles, eliminating tailpipe emissions.
              </p>
            </div>
          </article>

          <!-- Card 4: 95% fewer carbon miles -->
          <article class="relative flex min-h-48 flex-col justify-between overflow-hidden rounded-2xl border border-[#e3dfd3] bg-[#f2f0e4] p-6">
            <img
              src="/delivery/carbon-miles.jpg"
              alt="Forested hills representing reduced carbon emissions"
              width="150"
              height="149"
              loading="lazy"
              decoding="async"
              class="pointer-events-none absolute right-0 bottom-0 h-full w-[52%] object-cover object-right-bottom select-none"
            />
            <div
              class="pointer-events-none absolute inset-y-0 right-[38%] w-16 bg-gradient-to-r from-[#f2f0e4] via-[#f2f0e4]/80 to-transparent"
              aria-hidden="true"
            />
            <div class="relative z-10 max-w-[62%]">
              <span
                class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-[#b5bf9d] text-white"
                aria-hidden="true"
              >
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z" />
                  <path d="M12 13v5" />
                  <path d="m9.5 15.5 2.5-2.5 2.5 2.5" />
                </svg>
              </span>
              <h3 class="mt-3.5 font-display text-[1.45rem] leading-[1.15] text-charcoal">
                95% fewer<br />carbon miles
              </h3>
              <p class="mt-2.5 text-[0.82rem] leading-[1.45] text-[#66615b]">
                Our delivery operations are designed to achieve 95% fewer carbon miles, helping reduce emissions on every order.
              </p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="bg-botanical-deep text-canvas">
      <div class="site-container grid gap-10 py-16 md:grid-cols-2 md:items-center md:py-28">
        <div>
          <p class="eyebrow !text-sage">From source to service</p>
          <h2 class="section-title mt-4">A story grounded in the details.</h2>
          <p class="mt-6 max-w-xl text-lg leading-8 text-sage">
            Sourcing, growing, handling, and distribution information will be
            added here when verified company details are supplied. The structure
            is ready without making claims on the business’s behalf.
          </p>
          <a class="mt-8 inline-flex text-link !text-canvas" href="/about">About Greenleaf Co</a>
        </div>
        <img
          src="/source-to-service.jpg"
          alt="From source to delivery: harvesting, washing, sorting, packing, and delivering fresh produce to partners"
          width="1200"
          height="675"
          loading="lazy"
          decoding="async"
          class="aspect-[3/2] w-full border border-canvas/20 object-cover"
        />
      </div>
    </section>

    <section class="section-space bg-[#f9f2e8]">
      <div class="site-container grid items-center gap-12 lg:grid-cols-[0.95fr_1.05fr]">
        <div>
          <SectionHeading
            eyebrow="A practical view"
            title="Sustainability starts with what we can control."
            description="Responsible choices are best explained with evidence. This space is prepared for verified information about growing, resource use, packaging, waste, and distribution."
          />
          <a class="text-link mt-8" href="/sustainability">Our approach</a>
        </div>
        <img
          src="/sustainability-packaging.jpg"
          alt="Fresh leafy greens and cherry tomatoes in compostable packaging and recyclable materials"
          width="529"
          height="365"
          loading="lazy"
          decoding="async"
          class="w-full object-contain"
        />
      </div>
    </section>

    {
      journalEnabled && (
        <section class="section-space border-t border-line">
          <div class="site-container">
            <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
              <SectionHeading
                eyebrow="Culinary journal"
                title="Ideas shaped around the ingredient."
                description="Recipes, techniques, and product notes can help professional buyers see where distinctive produce fits."
              />
              <a class="text-link shrink-0" href="/journal">Visit the journal</a>
            </div>
            {
              journalEntries.length > 0 ? (
                <div class="mt-12 grid gap-8 md:grid-cols-2">
                  {journalEntries.slice(0, 2).map((entry) => <JournalCard entry={entry} />)}
                </div>
              ) : (
                <div class="mt-12 grid gap-8 md:grid-cols-2">
                  <MediaPlaceholder aspect="landscape" tone="earth" label="Journal imagery pending" />
                  <div class="self-center py-8">
                    <p class="eyebrow">Content placeholder</p>
                    <h3 class="mt-4 text-4xl">The journal is ready for its first story.</h3>
                    <p class="mt-5 leading-7 text-muted">
                      Publish recipes, ingredient notes, or kitchen inspiration in Sanity
                      and they will appear here.
                    </p>
                  </div>
                </div>
              )
            }
          </div>
        </section>
      )
    }

    <QuoteCTA
      title={homepage?.quoteCtaHeading}
      description={homepage?.quoteCtaText}
    />
  </main>
</BaseLayout>
