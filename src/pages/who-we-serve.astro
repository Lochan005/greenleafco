---
import QuoteCTA from '@/components/astro/QuoteCTA.astro';
import SectionHeading from '@/components/astro/SectionHeading.astro';
import PartnerBrandGallery from '@/components/react/PartnerBrandGallery';
import { partnerCategories } from '@/lib/content/partnerBrands';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Who We Serve"
  description="Specialty fresh produce for restaurants, hotels, hospitality groups, retailers, resellers, and distributors."
>
  <main>
    <h1 class="sr-only">Who We Serve</h1>

    <section class="section-space">
      <div class="site-container">
        <SectionHeading
          eyebrow="The businesses we serve"
          title="Good produce brings good businesses together."
          description="From independent cafés to retail and food distribution, we support businesses across the food ecosystem."
        />
        <PartnerBrandGallery categories={partnerCategories} client:load />
      </div>
    </section>

    <section class="border-t border-line bg-paper">
      <div class="site-container py-14 md:py-20">
        <h2 class="section-title max-w-3xl">Looking for a dependable specialty produce supplier?</h2>
        <a class="text-link mt-8" href="/request-a-quote">Discuss wholesale supply</a>
      </div>
    </section>

    <QuoteCTA />
  </main>
</BaseLayout>
