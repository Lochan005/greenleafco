---
import MediaPlaceholder from '@/components/astro/MediaPlaceholder.astro';
import QuoteCTA from '@/components/astro/QuoteCTA.astro';
import SectionHeading from '@/components/astro/SectionHeading.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';

const audiences = [
  {
    number: '01',
    title: 'Restaurants & chefs',
    copy: 'Discover ingredients by category, culinary use, and the details that matter when planning a menu.',
  },
  {
    number: '02',
    title: 'Hotels & hospitality',
    copy: 'Explore a broad produce range with a direct route to discuss recurring and event-led requirements.',
  },
  {
    number: '03',
    title: 'Retail teams',
    copy: 'Review visually distinctive produce and start a conversation about suitable formats and presentation.',
  },
  {
    number: '04',
    title: 'Resellers & distributors',
    copy: 'Use the catalogue as a clear starting point for range, pack-size, and availability discussions.',
  },
];
---

<BaseLayout
  title="Who We Serve"
  description="Specialty fresh produce for restaurants, hotels, hospitality groups, retailers, resellers, and distributors."
>
  <main>
    <section class="site-container grid gap-10 py-14 md:grid-cols-[1fr_0.8fr] md:items-end md:py-24">
      <div>
        <p class="eyebrow">Who we serve</p>
        <h1 class="display-title mt-5">Built around professional buyers.</h1>
      </div>
      <p class="body-large">
        Different businesses ask different questions of fresh produce. Our
        catalogue and enquiry path are designed to start those conversations clearly.
      </p>
    </section>

    <section class="border-y border-line bg-paper">
      <div class="site-container grid gap-8 py-10 md:grid-cols-2">
        <MediaPlaceholder aspect="landscape" tone="dark" label="Hospitality photography pending" />
        <MediaPlaceholder aspect="landscape" tone="earth" label="Produce handling photography pending" />
      </div>
    </section>

    <section class="section-space">
      <div class="site-container">
        <SectionHeading
          eyebrow="Different operations, one clear starting point"
          title="Find the range. Then shape the conversation."
        />
        <div class="mt-12 grid border-t border-line md:grid-cols-2">
          {
            audiences.map((audience) => (
              <article class="border-b border-line py-9 md:odd:border-r md:odd:pr-10 md:even:pl-10">
                <p class="text-xs text-muted">{audience.number}</p>
                <h2 class="mt-7 text-4xl">{audience.title}</h2>
                <p class="mt-4 max-w-lg leading-7 text-muted">{audience.copy}</p>
                <a class="text-link mt-6" href="/products">Explore products</a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="bg-botanical-deep text-canvas">
      <div class="site-container grid gap-10 py-16 md:grid-cols-[0.8fr_1.2fr] md:items-center md:py-24">
        <p class="eyebrow !text-sage">A useful enquiry</p>
        <div>
          <h2 class="section-title">Tell us how your business buys.</h2>
          <p class="mt-6 max-w-2xl text-lg leading-8 text-sage">
            Product interests, likely quantities, delivery location, and business
            type give the wholesale team a practical place to begin.
          </p>
        </div>
      </div>
    </section>

    <QuoteCTA />
  </main>
</BaseLayout>
